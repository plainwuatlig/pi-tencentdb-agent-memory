  "type": "module",
  "license": "MIT",
  "author": "Plain Wu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plainwuatlig/pi-tencentdb-agent-memory.git"
  },
  "homepage": "https://github.com/plainwuatlig/pi-tencentdb-agent-memory#readme",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "tencentdb",
    "agent-memory",
    "tdai"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
